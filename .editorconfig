# Line endings, indentation and trimming, for the files no formatter reaches.
#
# oxfmt covers what `scripts/format.ts` hands it: the `.ts` under src, scripts, test and
# tools, plus charcheck.config.ts. Everything else in this repo -- the markdown under
# docs, the YAML workflows, the JSON configs, the ADRs -- is written by editors and
# agents with nothing to correct them, which is how a stray tab or a CRLF gets in.
#
# oxfmt does NOT read this file. The `.ts` settings below are a hand-kept duplicate of
# `.oxfmtrc.jsonc`, and duplicates drift silently: a change to one is a change to both,
# in the same commit. If they ever disagree, `.oxfmtrc.jsonc` is what actually runs and
# `format:check` is what fails.

root = true

[*]
# LF everywhere, matching `* text=auto eol=lf` in .gitattributes. Both are needed: git
# normalizes what it stores, this settles what an editor writes before git sees it.
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ts]
# Mirrors .oxfmtrc.jsonc: printWidth 100, useTabs false, tabWidth 2.
max_line_length = 100

[*.md]
# Two trailing spaces is a hard line break in markdown, so trimming them silently edits
# the prose. The formatter never touches these files; this is the only rule protecting
# them.
trim_trailing_whitespace = false

[*.{yml,yaml}]
# YAML is whitespace-significant and a tab is a parse error, not a style choice.
indent_style = space
