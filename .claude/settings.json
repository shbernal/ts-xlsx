{
  "enabledMcpjsonServers": ["microsoft-learn"],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "out=$(node scripts/verify.ts --full --cached 2>&1) || { echo \"$out\" >&2; exit 2; }",
            "statusMessage": "Verifying (cached if the tree is unchanged)",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
