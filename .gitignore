# Logs
*.log

# Build output
dist/

# Coverage
coverage/

# The website's derived state. www/docs/ is the generated mirror of the tracked docs/
# tree: it is rewritten whole on every build, so a copy in history would be a second
# place to fix a typo.
www/docs/
www/.vitepress/cache/
www/.vitepress/dist/

# Dependencies
node_modules/

# A stray npm lockfile would shadow pnpm-lock.yaml; keep it out of history.
package-lock.json

# Editors
.idea/
.vscode/

# OS
.DS_Store

# Generated xlsx during tests…
*.xlsx
# …but durable corpus fixtures are the exception: they are the regression corpus's
# sample inputs and MUST be tracked (see test/corpus/README.md).
!test/corpus/fixtures/**

# THE scratch directory: throwaway probes, dumps, round-trip artefacts, GUI-automation
# screenshots, and derived state like the verify stamp. Anything here is regenerable and
# never committed. .gitkeep is tracked so a fresh clone can write here immediately —
# see the scratch rule in CLAUDE.md. (Contents, not the directory: git cannot re-include a
# file whose parent directory is itself excluded.)
.tmp/*
!.tmp/.gitkeep
